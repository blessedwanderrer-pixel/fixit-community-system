# Public Supabase project configuration used by the browser auth client.
# Never place the Supabase secret/service-role key in a VITE_* variable.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# FastAPI origin, without a trailing slash.
VITE_API_BASE_URL="http://localhost:8000"

# Must also be present in Supabase Authentication > URL Configuration > Redirect URLs.
# Omit locally to use the current origin automatically, or set an explicit deployed URL.
VITE_PASSWORD_RESET_REDIRECT_URL="http://localhost:3000/reset-password"

# Used after a citizen confirms a new account. Add this URL to the same Supabase redirect allow-list.
VITE_SIGNUP_REDIRECT_URL="http://localhost:3000/login?email-confirmed=true"
