# Application
APP_NAME=FixIt Community API
APP_ENVIRONMENT=development
DEBUG=false

# Supabase (replace placeholders in a local .env file)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_REQUEST_TIMEOUT_SECONDS=10

# Groq AI triage (backend only)
GROQ_API_KEY=your-groq-api-key
CRON_SECRET=generate-a-long-random-secret
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_FROM_EMAIL=your-gmail-address@gmail.com
GOOGLE_APP_PASSWORD=your-google-app-password
PUBLIC_FRONTEND_URL=https://fixit-community-web.vercel.app
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Urdu voice complaints use Groq Whisper model whisper-large-v3-turbo.

# Server-side sanitized image limits (private Supabase Storage uploads)
MEDIA_MAX_UPLOAD_BYTES=8388608
MEDIA_MAX_PIXELS=25000000

# Comma-separated development frontend origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Add variables for external services only after those services are selected.
